  "lyrics": [
    {
      "start": 0.4,
      "end": 5.2,
      "text": "碧云天，黄叶地。",
      "note": "秋空澄澈如碧玉，黄叶铺地，立尽天地苍茫。"
    },
    {
      "start": 5.2,
      "end": 10.2,
      "text": "秋色连波，波上寒烟翠。",
      "note": "秋水共长天相连，渺渺江波笼罩寒烟翠雾。"
    },
    {
      "start": 10.2,
      "end": 15.2,
      "text": "山映斜阳天接水。",
      "note": "暮山映照落日余晖，水天相接浩渺无际。"
    },
    {
      "start": 15.2,
      "end": 20.0,
      "text": "芳草无情，更在斜阳外。",
      "note": "芳草不谙游子羁旅愁肠，绵延向斜阳之外。"
    }
  ]
